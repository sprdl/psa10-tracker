{
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(git pull:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push -q)",
      "Bash(git rev-parse:*)",
      "Bash(rm -f .git/index.lock)",
      "Bash(rm -f .git/*.lock)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tee:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(sleep:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(mkdir -p data/incoming)",
      "Read",
      "Edit(./**)",
      "Write(./**)",
      "WebSearch",
      "WebFetch(domain:*)",
      "Skill(pokemon-card-price-check)",
      "Skill(pokemon-tcg-card-evaluation)",
      "mcp__claude-in-chrome"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.psa10/widget/hooks/stop.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.psa10/widget/hooks/notify.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.psa10/widget/hooks/clear.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.psa10/widget/hooks/clear.sh"
          }
        ]
      }
    ]
  }
}
